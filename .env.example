# ---- Pharma AI OS environment template ------------------------------------
# Copy to .env (backend) or export in your shell / docker-compose environment.

# App
ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=pharmacy_ai_os
USE_TXNS=true

# Redis (optional; rate limiting + locking when present)
REDIS_URL=redis://localhost:6379/0

# Auth — REQUIRED to change in any shared environment
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=14

# AI (optional; offline deterministic extractors used when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# Storage: s3 | gridfs | local  (auto → s3 if configured, else GridFS)
STORAGE_BACKEND=auto
S3_ENDPOINT=
S3_BUCKET=pharmaos-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOCAL_UPLOAD_DIR=uploads

# Features
ENABLE_MARKET_TO_ORDER=true
ENABLE_AGENTS=true
SEED_DEMO=false            # set 1/true once to load masters + demo dataset

# Notifications (V1: simulated only — no SMTP)
EMAIL_MODE=SIMULATED

# Policy defaults
PO_AUTO_APPROVAL_LIMIT=100000
PAYMENT_AUTHORIZATION_LIMIT=250000
MATCH_TOLERANCE_PCT=1.0
RATE_LIMIT_PER_MIN=600
